-- TASK 1
SELECT FIRST_NAME || ' ' || UPPER(LAST_NAME) AS TAM_AD,
SUBSTR(FIRST_NAME, 1,1) || '.' || ' ' || LAST_NAME AS QISA_AD, 
LOWER(EMAIL) || '@company.com' AS EMAIL
FROM HR.EMPLOYEES
ORDER BY LAST_NAME;

--TASK 2
SELECT FIRST_NAME,
TO_CHAR(SALARY,'FM999,999') || ' ' || 'AZN' AS MAAS, 
TO_CHAR((SALARY*12), 'FM999,999.00') AS ILLIK_MAAS 
FROM HR.EMPLOYEES
ORDER BY SALARY DESC;
-- ORDER BY MAAS DESC MAAS'I ASCII CEDVELINE UYGUN SIRALAYIR

--TASK 3
SELECT FIRST_NAME,
TO_CHAR(HIRE_DATE, 'DD.MM.YYYY') AS ISE_GIRIS,
EXTRACT(YEAR FROM HIRE_DATE) AS IL,
TO_CHAR(HIRE_DATE, 'FMMonth')AS AY_ADI,
TO_CHAR(HIRE_DATE, 'FMDay')AS HEFTE_GUNU
FROM HR.EMPLOYEES
ORDER BY HIRE_DATE;

--TASK 4
SELECT INITCAP(FIRST_NAME) || ' ' || INITCAP(LAST_NAME) AS ISCI,
TO_CHAR(HIRE_DATE, 'FMDD Month YYYY') AS ISE_GIRIS,
TRUNC(MONTHS_BETWEEN(SYSDATE,HIRE_DATE)/12) || ' il ' || MOD(TRUNC(MONTHS_BETWEEN(SYSDATE,HIRE_DATE)),12) || ' ay' AS STAJ 
FROM HR.EMPLOYEES
ORDER BY HIRE_DATE;

--TASK 5 
-- a)
SELECT FIRST_NAME, HIRE_DATE,
ADD_MONTHS(HIRE_DATE,3) AS SINAQ_BITIR,
LAST_DAY(HIRE_DATE) AS ILK_MAAS_GUNU,
LAST_DAY(HIRE_DATE) - HIRE_DATE AS MAASA_QALAN_GUN
FROM HR.EMPLOYEES;

-- b)
SELECT ADD_MONTHS(TO_DATE('28.02.2025', 'DD.MM.YYYY'),3)
FROM DUAL;
-- fevralin 28'in uzerine ay gelende alinan ayin axirina gelir


-- TASK 6.
-- 1. CONCAT ICERISINDE IKI'DEN ARTIQ VALUE OLABILMEZ.
-- 2. TO_CHAR(COMMISSION_PCT,'FM0.00') YAZILMASA 0.20 .2 KIMI GORSENECEK.
-- 3. SERT HISSESI HEC VAXT ISLEMEYECEK. MM HEC VAXT 3'E BERABER OLMUR
SELECT CONCAT(CONCAT(FIRST_NAME, ' '), LAST_NAME) || ', komissiya: ' || NVL(TO_CHAR(COMMISSION_PCT,'FM0.00'), 'yoxdur') AS MELUMAT
FROM HR.EMPLOYEES
WHERE TO_CHAR(HIRE_DATE, 'MM') = '03';

-- TASK 7.
SELECT 
TO_CHAR(HIRE_DATE, 'MM') AS AY_NO,
TO_CHAR(HIRE_DATE, 'FMMonth') AS AY,
COUNT(*) AS ISCI_SAYI
FROM HR.EMPLOYEES
GROUP BY TO_CHAR(HIRE_DATE, 'MM'),
TO_CHAR(HIRE_DATE, 'FMMonth')
ORDER BY AY_NO;
-- ORDER BY AY ETSEYDIK, ELIFBA SIRASI ILE CIXARACAQDI

--TASK 8
SELECT EMPLOYEE_ID,
LOWER(SUBSTR(FIRST_NAME, 1, 1)) || LOWER(LAST_NAME) || LPAD(EMPLOYEE_ID,4,'0') AS LOGIN,
REPLACE(PHONE_NUMBER, '.', '-') AS TELEFON 
FROM HR.EMPLOYEES
WHERE LENGTH(LAST_NAME) >= 7
ORDER BY LOGIN;

--TASK 9
--MIN(TO_CHAR(HIRE_DATE, 'DD.MM.YYYY')) YAZSAQ GUN ILE SIRALAYACAQ
SELECT
EXTRACT(YEAR FROM HIRE_DATE) AS IL,
COUNT(*) AS ISCI_SAYI,
TO_CHAR(MIN(HIRE_DATE), 'DD.MM.YYYY') AS ILK_TARIX,
TO_CHAR(MAX(HIRE_DATE), 'DD.MM.YYYY') AS SON_TARIX,
TO_CHAR(AVG(SALARY),'FM99,999.00') AS ORTA_MAAS
FROM HR.EMPLOYEES
GROUP BY EXTRACT(YEAR FROM HIRE_DATE)
ORDER BY IL ASC;


-- TASK 10.
-- a)
SELECT FIRST_NAME,
TO_CHAR(HIRE_DATE, 'Dy') || ',' || ' ' || TO_CHAR(HIRE_DATE, 'DD.MM.YYYY') AS ISE_GIRIS,
CASE 
    WHEN TO_CHAR(HIRE_DATE, 'FMDAY') = 'SATURDAY' OR TO_CHAR(HIRE_DATE, 'FMDAY') = 'SUNDAY' THEN 'Hefte sonu'
    ELSE 'Is gunu'
    END AS GUN_NOVU
FROM HR.EMPLOYEES;

-- b)
SELECT 
TO_CHAR(HIRE_DATE, 'FMDay') AS GUN,
count(*) AS ISCI_SAYI
FROM HR.EMPLOYEES
GROUP BY TO_CHAR(HIRE_DATE, 'FMDay')
ORDER BY ISCI_SAYI DESC;
--BOSLUGA GORE CASE ISLEMEYECEK
