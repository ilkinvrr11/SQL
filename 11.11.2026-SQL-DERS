--TASK 1
SELECT DEPARTMENT_ID, MAX(SALARY) AS MAKS_MAAS
FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID IS NOT NULL
GROUP BY DEPARTMENT_ID
ORDER BY MAKS_MAAS DESC;

--TASK 2
SELECT LOCATION_ID, COUNT(*) AS SOBE_SAYI
FROM HR.DEPARTMENTS
GROUP BY LOCATION_ID
ORDER BY SOBE_SAYI DESC;

--TASK 3
SELECT E.FIRST_NAME,E.LAST_NAME,D.DEPARTMENT_NAME 
FROM HR.EMPLOYEES E 
JOIN HR.DEPARTMENTS D ON E.DEPARTMENT_ID = D.DEPARTMENT_ID;

--TASK 4
SELECT JOB_ID,SUM(SALARY) AS UMUMI_MAAS FROM HR.EMPLOYEES
GROUP BY JOB_ID
HAVING SUM(SALARY)>30000;

--TASK 5
SELECT DEPARTMENT_ID, MIN(SALARY) AS MIN_MAAS FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID IS NOT NULL
GROUP BY DEPARTMENT_ID
HAVING MIN(SALARY) > 4000
ORDER BY MIN(SALARY) ASC;

--TASK 6
SELECT J.JOB_TITLE, ROUND(AVG(E.SALARY),2) AS ORTA_MAAS
FROM HR.EMPLOYEES E
JOIN HR.JOBS J ON E.JOB_ID = J.JOB_ID
GROUP BY J.JOB_TITLE
HAVING AVG(E.SALARY) BETWEEN 6000 AND 12000;

--TASK 7
SELECT J.JOB_TITLE 
FROM HR.JOBS J 
LEFT JOIN HR.EMPLOYEES E ON J.JOB_ID = E.JOB_ID
WHERE E.JOB_ID IS NULL;

--TASK 8
-- 1. 3-CU SETRDE E.DEPARTMENT_ID YAZILMALIDIR
-- 2. HAVING ISLEDILMELIDIR WHERE EVEZINE
-- 3. 
SELECT D.DEPARTMENT_NAME, COUNT(*) AS ISCI_SAYI
FROM HR.EMPLOYEES E
JOIN HR.DEPARTMENTS D ON E.DEPARTMENT_ID = D.DEPARTMENT_ID
GROUP BY D.DEPARTMENT_NAME
HAVING COUNT(*) > 4;

-- TASK 9
SELECT DEPARTMENT_ID,MANAGER_ID,COUNT(JOB_ID) AS ISCI_SAYI 
FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID IS NOT NULL AND MANAGER_ID IS NOT NULL 
GROUP BY DEPARTMENT_ID,MANAGER_ID;

--TASK 10
SELECT L.CITY, SUM(E.SALARY) AS UMUMI_MAAS 
FROM HR.EMPLOYEES E 
JOIN HR.DEPARTMENTS D ON E.DEPARTMENT_ID = D.DEPARTMENT_ID
JOIN HR.LOCATIONS L ON D.LOCATION_ID = L.LOCATION_ID
GROUP BY L.CITY
HAVING SUM(E.SALARY) > 20000
ORDER BY UMUMI_MAAS DESC;

--TASK 11
SELECT L.CITY, COUNT(D.DEPARTMENT_ID) AS SOBE_SAYI
FROM HR.LOCATIONS L 
LEFT JOIN HR.DEPARTMENTS D ON D.LOCATION_ID = L.LOCATION_ID
GROUP BY L.CITY
ORDER BY SOBE_SAYI DESC;

--TASK 12
SELECT D.DEPARTMENT_NAME, ROUND(AVG(E.SALARY)) AS ORTA_MAAS,
COUNT(*) AS ISCI_SAYI FROM HR.EMPLOYEES E 
JOIN HR.DEPARTMENTS D ON E.DEPARTMENT_ID = D.DEPARTMENT_ID
WHERE E.SALARY>5000
GROUP BY D.DEPARTMENT_NAME
HAVING COUNT(*)>2;

--TASK 13
SELECT JOB_TITLE,DEPARTMENT_NAME, COUNT(*) AS ISCI_SAYI
FROM HR.JOBS J
JOIN HR.EMPLOYEES E ON E.JOB_ID = J.JOB_ID
JOIN HR.DEPARTMENTS D ON E.DEPARTMENT_ID = D.DEPARTMENT_ID
GROUP BY J.JOB_TITLE,D.DEPARTMENT_NAME
ORDER BY J.JOB_TITLE ASC;
